# Обязательно
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ID чатов менеджеров через запятую (дополнительно к telegram_chat_id в таблице managers)
MANAGER_CHAT_IDS=123456789,987654321

# GigaChat — свободный текст в главном меню (developers.sber.ru → GigaChat API → ключ авторизации)
GIGACHAT_AUTH_KEY=ваш_ключ_авторизации_base64
GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_TEMPERATURE=0.3
# GIGACHAT_MAX_TOKENS=300
# Сертификат Сбера на Windows (по умолчанию true; отключить: false)
# GIGACHAT_INSECURE_SSL=true

# Кэш справочников из БД, мс (по умолчанию 300000 = 5 мин)
# CATALOG_CACHE_TTL_MS=300000
